APP_NAME=BTS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Database (matches docker-compose.yml db service)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bts_db
DB_USERNAME=bts_user
DB_PASSWORD=bts_password

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

QUEUE_CONNECTION=sync

# Swagger
L5_SWAGGER_GENERATE_ALWAYS=true
